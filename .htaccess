# BharatPlay – Apache / LiteSpeed / OpenLiteSpeed (aaPanel "OLS") rules
#
# Only RewriteRule-based blocking is used, because OpenLiteSpeed ignores
# <FilesMatch>, Require and per-folder .htaccess files. Works on Apache too.
# On aaPanel with OpenLiteSpeed: Website → site → URL rewrite shows THIS file –
# never paste Nginx rules there. (Nginx servers: use deploy/nginx-aapanel.conf.)

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS (aaPanel: use Website → SSL → Force HTTPS instead)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Private code, config, logs, cron, deploy files
RewriteRule ^(config|includes|logs|cron|deploy|cli)(/|$) - [F,L]
RewriteRule ^(admin|app)/includes(/|$) - [F,L]
# Raw videos only via /api/video-stream.php (login + premium check); unfinished uploads
RewriteRule ^uploads/(videos|tmp)(/|$) - [F,L]
# Nothing in thumbnails may execute
RewriteRule ^uploads/thumbnails/.*\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh)$ - [F,NC,L]
# Dumps, docs, logs, ini/env, backups anywhere
RewriteRule \.(sql|md|lock|log|bak|ini|sh|env)$ - [F,NC,L]
# Dotfiles (.git, .env, .user.ini, .htaccess) – but keep Let's Encrypt working
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
